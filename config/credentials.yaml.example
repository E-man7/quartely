# Optional: copy to credentials.yaml (git-ignored) for alert settings.
# Secrets go in .env, not here: ALPACA_API_KEY / ALPACA_SECRET_KEY (Alpaca keys
# in this file are ignored), SMTP_PASSWORD and ALERT_WEBHOOK_URL.

email:
  smtp_host: smtp.gmail.com
  smtp_port: 587
  username: "you@example.com"
  from_addr: "you@example.com"
  to_addrs: ["you@example.com"]

# webhook URL: ALERT_WEBHOOK_URL in .env (Slack / Discord / generic JSON endpoint)
